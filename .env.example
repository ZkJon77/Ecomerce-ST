# Asaas: use Sandbox durante os testes e Produção somente após homologação.
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token de autenticação criado nas configurações do Webhook do Asaas (não é a API Key).
ASAAS_WEBHOOK_TOKEN=

# Em produção, use a URL HTTPS pública do site.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp / Operação do atendimento
STORE_PHONE=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
