# Mercado Pago
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_DO_MERCADO_PAGO
# Segredo gerado em Mercado Pago > Webhooks > Assinatura secreta.
# Obrigatório para autenticar notificações em produção.
MP_WEBHOOK_SECRET=
# Em produção, use a URL HTTPS pública do site.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp / Operação do atendimento
STORE_PHONE=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Supabase
# URL do projeto. NEXT_PUBLIC_SUPABASE_URL também é aceita pelo backend.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon ou sb_publishable_); pode ser usada no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta do Supabase, exclusiva do servidor.
# Use SUPABASE_SECRET_KEY (preferida) ou SUPABASE_SERVICE_ROLE_KEY (legada).
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
