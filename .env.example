# Asaas: mantenha Sandbox durante os testes.
ASAAS_ENV=sandbox
# Opcional: deixe vazio para usar a URL definida por ASAAS_ENV.
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=
ASAAS_API_KEY=
# Token de autenticação criado nas configurações do Webhook do Asaas (não é a API Key).
ASAAS_WEBHOOK_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp / Operação do atendimento
STORE_PHONE=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Compatibilidade com projetos que ainda usam a chave antiga:
SUPABASE_SERVICE_ROLE_KEY=
